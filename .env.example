# Copy to .env at the repo root (shared by apps/web and apps/worker). Never commit .env.
# Empty values count as unset. With everything below left empty the app runs fully in MOCK mode.

# ---- App mode -------------------------------------------------------------
# mock: no external keys needed. live: Supabase vars below become required.
APP_MODE=mock

# ---- Supabase (project settings > API / Connect) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server + worker ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
# Postgres connection strings (session / transaction pooler). Used by pg-boss (Phase 4) and the DB test runner.
DATABASE_URL=
DATABASE_POOLER_URL=

# ---- Adapters: mock (default) or live -------------------------------------
ADAPTER_LLM=mock          # live needs the key of LLM_PROVIDER (ANTHROPIC_API_KEY or OPENROUTER_API_KEY)
ADAPTER_SEARCH=mock       # live needs SERPER_API_KEY
ADAPTER_FETCHER=mock      # live: public pages only, robots.txt honoured, no key. mock = invented demo pages: must be live for a real run
ADAPTER_CRUNCHBASE=mock   # live needs CRUNCHBASE_API_KEY (Enterprise/Applications licence); off by default
ADAPTER_APOLLO=mock       # live needs APOLLO_API_KEY
ADAPTER_VERIFIER=mock     # live needs VERIFIER_API_KEY (ZeroBounce; ZEROBOUNCE_API_KEY works too)
ADAPTER_GMAIL=mock        # live needs GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY

# How Claude is reached when ADAPTER_LLM=live: anthropic (default) or openrouter. Switch by changing this and restarting.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SERPER_API_KEY=
# Jina Reader fallback for pages our own fetch could not read (script-only or empty pages). Works without a key; JINA_API_KEY only raises the rate limit. FETCHER_READER=off switches it off.
JINA_API_KEY=
FETCHER_READER=
CRUNCHBASE_API_KEY=
APOLLO_API_KEY=
VERIFIER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the app is reachable. The Google redirect URI is this + /api/google/callback (register exactly that in Google Cloud).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Cloud > OAuth consent screen > Publishing status: "testing" (Gmail sign-ins expire after 7 days, the app warns) or "production".
GOOGLE_APP_PUBLISHING=testing
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts OAuth refresh tokens with AES-256-GCM.
TOKEN_ENCRYPTION_KEY=
# Real sending is impossible unless this is exactly "true" (checked by the send job in Phase 11).
ALLOW_LIVE_SEND=false

# ---- Worker ---------------------------------------------------------------
WORKER_ID=
HEARTBEAT_INTERVAL_SECONDS=30
# Web health endpoint reports the worker as stale after this many seconds without a heartbeat.
WORKER_STALE_AFTER_SECONDS=90

# ---- Login user (read by `pnpm user:create`; edit and re-run any time) ----
# ADMIN_PASSWORD (min 8 chars) is set on create AND on re-run for an existing user. Leave empty to auto-generate for new users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
ADMIN_NAME=
